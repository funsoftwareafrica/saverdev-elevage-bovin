// Prisma schema — CRM Application
// Contacts, Companies, Deals (Pipeline), Activities, Notes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Companies ----------
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String   @default("")
  website     String   @default("")
  location    String   @default("")
  employees   Int      @default(0)
  revenue     Float    @default(0)
  description String   @default("")
  status      String   @default("active")   // active, inactive, prospect
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]
  notes    Note[]

  @@index([name])
  @@index([industry])
}

// ---------- Contacts ----------
model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @default("")
  phone     String   @default("")
  position  String   @default("")        // job title
  avatar    String   @default("")
  source    String   @default("manual")  // manual, referral, website, linkedin, event
  status    String   @default("active")  // active, inactive, lead
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  notes      Note[]

  @@index([lastName])
  @@index([email])
  @@index([status])
}

// ---------- Deals (Pipeline) ----------
model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Float    @default(0)
  stage       String   @default("lead")  // lead, qualified, proposal, negotiation, closed_won, closed_lost
  probability Int      @default(0)       // 0-100
  closeDate   DateTime?
  description String   @default("")
  companyId   String?
  contactId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities Activity[]
  notes      Note[]

  @@index([stage])
  @@index([value])
}

// ---------- Activities ----------
model Activity {
  id          String   @id @default(cuid())
  type        String                     // call, email, meeting, task, note
  title       String
  description String   @default("")
  date        DateTime @default(now())
  completed   Boolean  @default(false)
  contactId   String?
  dealId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([date])
  @@index([completed])
}

// ---------- Notes ----------
model Note {
  id        String   @id @default(cuid())
  content   String
  companyId String?
  contactId String?
  dealId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
