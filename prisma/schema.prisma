// Prisma schema — Application Élevage Bovin d'Engraissement (SAVERDEV)
// Gestion : cheptel, achats, ventes, alimentation (imputation par tête),
// dépenses, financement, échéances, alertes, historique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & rôles ----------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(BENEFICIAIRE)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historiques Historique[]
}

enum Role {
  BENEFICIAIRE
  SINERGI
  E2A
}

// ---------- Cheptel ----------
model Bovin {
  id                String        @id @default(cuid())
  identifiant       String        @unique          // BOE-001, OVN-001
  espece            String        @default("BOVIN") // BOVIN ou OVIN
  gestionnaire      String        @default("SAVERDEV") // gestionnaire de l'animal
  race              String        @default("Zébu")
  sexe              String        @default("Mâle")
  dateAchat         DateTime
  prixAchat         Float                              // FCFA
  poidsAchat        Float         @default(0)            // kg
  statut            StatutBovin   @default(EN_ENGRAISSEMENT)
  dateVente         DateTime?
  prixVente         Float         @default(0)
  coutsEngraissement Float        @default(0)            // cumul auto (alimentation imputée)
  autresCouts       Float         @default(0)            // dépenses imputées
  clientVente       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  alimentations     AlimentationBovin[]
  depenses          DepenseBovin[]
  pesees            Pese[]
  soins             Soin[]

  @@index([statut])
  @@index([espece])
  @@index([gestionnaire])
}

enum StatutBovin {
  EN_ENGRAISSEMENT
  VENDU
  MORT
}

// ---------- Alimentation (achat d'aliments + imputation par tête) ----------
model Alimentation {
  id            String              @id @default(cuid())
  date          DateTime
  produit       String                               // ex: "Son de blé", "Tourteau coton"
  quantite      Float                                 // sacs ou kg
  unite         String              @default("sac")
  coutTotal     Float                                 // FCFA, payé pour le lot
  nbBovinsConcernes Int                               // nb têtes qui consomment
  coutParTete   Float              @default(0)         // calcul auto
  commentaire   String?
  createdAt     DateTime           @default(now())

  bovins        AlimentationBovin[]

  @@index([date])
}

model AlimentationBovin {
  id             String       @id @default(cuid())
  alimentationId String
  bovinId        String
  partImputee    Float                           // FCFA imputés à ce bovin

  alimentation   Alimentation @relation(fields: [alimentationId], references: [id], onDelete: Cascade)
  bovin          Bovin        @relation(fields: [bovinId], references: [id], onDelete: Cascade)

  @@unique([alimentationId, bovinId])
}

// ---------- Dépenses d'exploitation (soins, transport, main-d'œuvre, etc.) ----------
model Depense {
  id            String   @id @default(cuid())
  date          DateTime
  categorie    String                          // "Soins vétérinaires", "Transport", "Main-d'œuvre", "Autres"
  libelle       String
  montant       Float                            // FCFA
  nbBovinsConcernes Int   @default(0)            // 0 = charge globale non imputée
  createdAt     DateTime @default(now())

  bovins        DepenseBovin[]

  @@index([date])
  @@index([categorie])
}

model DepenseBovin {
  id          String  @id @default(cuid())
  depenseId   String
  bovinId     String
  partImputee Float

  depense Depense @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  bovin  Bovin   @relation(fields: [bovinId], references: [id], onDelete: Cascade)

  @@unique([depenseId, bovinId])
}

// ---------- Financement & échéances (côté bailleur) ----------
model Financement {
  id             String   @id @default(cuid())
  bailleur       String                          // "SAVERDEV", "BOA", etc.
  montantFinance Float                           // FCFA accordés
  dateOctroi     DateTime
  tauxInteret    Float     @default(0)             // % annuel
  dureeMois      Int
  echeances      Echeance[]
  createdAt      DateTime @default(now())
}

model Echeance {
  id             String       @id @default(cuid())
  financementId  String
  numero         Int                              // 1, 2, 3...
  datePrevue     DateTime
  montant        Float                            // FCFA à rembourser
  statut         StatutEcheance @default(A_PAYER)
  datePayee      DateTime?

  financement    Financement @relation(fields: [financementId], references: [id], onDelete: Cascade)

  @@index([statut])
}

enum StatutEcheance {
  PAYEE
  A_PAYER
  EN_RETARD
}

// ---------- Alertes ----------
model Alerte {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String                          // "ECHEANCE", "BUDGET", "MORTALITE", "MARGE", "AUTRE"
  severite    String                          // "INFO", "WARNING", "CRITICAL"
  message     String
  resolved    Boolean  @default(false)
}

// ---------- Historique / journal ----------
model Historique {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  userId      String?
  action      String                          // "CREATE_BOVIN", "VENTE", "ALIMENTATION", etc.
  entiteType  String                          // "Bovin", "Vente", "Alimentation"...
  entiteId    String?
  details     String?

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
}

// ---------- Tags personnalisables (bovins) ----------
model Tag {
  id        String   @id @default(cuid())
  bovinId   String
  tag       String
  color     String   @default("#10B981")
  createdAt DateTime @default(now())

  @@index([bovinId])
  @@index([tag])
}

// ---------- Photos de profil (bovins) ----------
model Photo {
  id        String   @id @default(cuid())
  bovinId   String
  url       String
  isProfile Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bovinId])
}

// ---------- Validation workflow ----------
model Validation {
  id          String   @id @default(cuid())
  entiteType  String
  entiteId    String
  action      String
  statut      String   @default("EN_ATTENTE")
  saisiePar   String?
  validePar   String?
  dateSaisie  DateTime @default(now())
  dateValidation DateTime?
  commentaire String?

  @@index([statut])
  @@index([entiteType])
}

// ---------- Gestion de stock (aliment bétail) ----------
model StockMouvement {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  typeAliment   String
  entree        Int      @default(0)
  sortie        Int      @default(0)
  prixParSac    Float    @default(0)
  observations  String?
  createdAt      DateTime @default(now())

  @@index([date])
  @@index([typeAliment])
}

// ---------- Capital initial & mouvements manuels (suivi financement) ----------
// Le capital initial est stocké dans Parametre (clé "capital_initial")
// et reste STATIQUE : on ne le modifie jamais directement.
// À chaque opération (entrée/sortie), on crée un CapitalMouvement horodaté
// (avec heure + minutes) qui vient ajouter ou soustraire du capital initial.
model CapitalMouvement {
  id        String   @id @default(cuid())
  date      DateTime                    // date + heure + minutes de l'opération
  libelle   String                      // motif de l'opération
  type      CapitalType                 // ENTREE (ajout) ou SORTIE (retrait)
  montant   Float                       // montant en FCFA
  saisiePar String?                     // utilisateur qui a saisi
  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
}

enum CapitalType {
  ENTREE
  SORTIE
}

// ---------- Paramètres applicatifs (capital initial, seuils, etc.) ----------
model Parametre {
  id          String   @id @default(cuid())
  cle         String   @unique            // ex: "capital_initial"
  valeur       String                       // valeur sérialisée (string)
  description String?
  updatedAt   DateTime @updatedAt
}

// ---------- Pâturages (géolocalisation des parcelles) ----------
model Paturage {
  id          String   @id @default(cuid())
  nom         String
  surface     Float                          // hectares
  coordonnees String?                       // "lat,lng" ou adresse
  capacite    Int                            // nb bovins
  createdAt   DateTime @default(now())

  @@index([nom])
}

// ---------- Pesées connectées (suivi poids bovin) ----------
model Pese {
  id        String   @id @default(cuid())
  bovinId   String
  date      DateTime @default(now())
  poids     Float                           // kg
  methode   String   @default("Manuelle")   // "Manuelle" | "Connectée"
  createdAt DateTime @default(now())

  bovin     Bovin?   @relation(fields: [bovinId], references: [id], onDelete: Cascade)

  @@index([bovinId])
  @@index([date])
}

// ---------- Soins vétérinaires (carnet de santé) ----------
model Soin {
  id              String    @id @default(cuid())
  bovinId         String
  date            DateTime  @default(now())
  type            String                          // "Contrôle" | "Vaccin" | "Traitement" | ...
  libelle         String
  cout            Float     @default(0)             // FCFA
  prochainRappel  DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  bovin           Bovin?    @relation(fields: [bovinId], references: [id], onDelete: Cascade)

  @@index([bovinId])
  @@index([date])
}

// ---------- Notifications (centre de notifications) ----------
model Notification {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  type      String                          // "ECHEANCE" | "BUDGET" | "MORTALITE" | ...
  titre     String
  message   String
  lu        Boolean  @default(false)
  lien      String?
  userId    String?

  @@index([date])
  @@index([lu])
}

// ---------- Sauvegardes (backup JSON complet) ----------
model Backup {
  id        String   @id @default(cuid())
  date      DateTime                          // date de la sauvegarde
  filename  String   @unique
  size      Int                               // bytes
  type      String                            // "manual" | "auto"
  entities  Int      @default(0)              // nb total d'entités exportées
  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
}
